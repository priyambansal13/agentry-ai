# Local development only. Never commit (.gitignore'd).
AGENTRY_ENV=dev
AGENTRY_DB_PORT=55432

# Better Auth (dashboard): its tables live in schema "auth", owned by role agentry_auth
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3201
AUTH_DATABASE_URL=postgres://agentry_auth:agentry_auth@localhost:55432/agentry
SMTP_HOST=localhost
SMTP_PORT=51025
MAIL_FROM="Agentry <hello@agentry.dev>"

# Dashboard and landing page -> Python API
AGENTRY_API_URL=http://localhost:8801
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3201
NEXT_PUBLIC_API_URL=http://localhost:8801

# Provider keys: set one or both. Models of a provider without a key are skipped.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model tiers: comma-separated LiteLLM model strings, tried in order (primary, then fallbacks). Mix providers freely:
#   AGENTRY_MODEL_FAST=gemini/<model>,openai/<model>
# Run `cd backend && uv run agentry models` to list the exact models your keys can use.
# Leave a tier empty to run it in mock mode (no network calls, zero cost).
AGENTRY_MODEL_FAST=
AGENTRY_MODEL_WRITER=
AGENTRY_MODEL_CONVERSATION=
AGENTRY_MODEL_VOICE=
AGENTRY_MODEL_VISION=
AGENTRY_MODEL_EMBED=

# Encrypts stored OAuth/API tokens (Fernet key): python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AGENTRY_ENCRYPTION_KEY=
AGENTRY_API_PUBLIC_URL=http://localhost:8801
AGENTRY_DASHBOARD_URL=http://localhost:3201
AGENTRY_GOOGLE_CLIENT_ID=
AGENTRY_GOOGLE_CLIENT_SECRET=
# Gmail push (optional, docs/setup/gmail.md §6)
AGENTRY_GMAIL_PUBSUB_TOPIC=
AGENTRY_GMAIL_PUSH_TOKEN=
# Outlook / Microsoft 365 (optional, docs/setup/outlook.md)
AGENTRY_MICROSOFT_CLIENT_ID=
AGENTRY_MICROSOFT_CLIENT_SECRET=
AGENTRY_MICROSOFT_TENANT=common
AGENTRY_WHATSAPP_APP_SECRET=
AGENTRY_WHATSAPP_VERIFY_TOKEN=
AGENTRY_WHATSAPP_GRAPH_VERSION=v23.0

# Voice (Phase 4). Local LiveKit runs from docker-compose (dev keys below); speech uses OPENAI_API_KEY.
# Phone calls want a fast, non-reasoning model: AGENTRY_MODEL_VOICE=openai/gpt-4.1-mini (unset = same as conversation)
AGENTRY_LIVEKIT_URL=ws://localhost:7880
AGENTRY_LIVEKIT_API_KEY=devkey
AGENTRY_LIVEKIT_API_SECRET=secret

# Telegram (docs/setup/telegram.md): Agentry's team bot from @BotFather; polling locally, webhooks when deployed
AGENTRY_TELEGRAM_BOT_TOKEN=
AGENTRY_TELEGRAM_WEBHOOK_SECRET=
# AGENTRY_TELEGRAM_MODE=polling
