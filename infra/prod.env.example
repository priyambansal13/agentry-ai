# Production settings for docker-compose.prod.yml (copy to infra/.env.prod) and the k3s Secret (docs/DEPLOY.md).
# No inline comments after values: Kubernetes reads this file literally.
# Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Fernet key:             python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# ---- Postgres (role passwords are applied on the FIRST start of an empty volume) ----
POSTGRES_PASSWORD=change-me-owner
# must equal POSTGRES_PASSWORD
AGENTRY_DB_OWNER_PASSWORD=change-me-owner
AGENTRY_DB_AUTH_PASSWORD=change-me-auth
AGENTRY_DB_APP_PASSWORD=change-me-app
AGENTRY_DB_SYSTEM_PASSWORD=change-me-system

# ---- Public URLs ----
# API base for OAuth redirects and webhooks
AGENTRY_API_PUBLIC_URL=https://api.agentry.example
AGENTRY_DASHBOARD_URL=https://app.agentry.example
# the public website (demo pages /demo/<slug> in sales emails)
AGENTRY_WEB_URL=https://agentry.example
# the dashboard URL; also the JWT issuer and audience
BETTER_AUTH_URL=https://app.agentry.example
AGENTRY_AUTH_ISSUER=https://app.agentry.example
AGENTRY_AUTH_AUDIENCE=https://app.agentry.example
AGENTRY_CORS_ORIGINS=["https://agentry.example","https://app.agentry.example"]

# ---- Secrets ----
BETTER_AUTH_SECRET=change-me
AGENTRY_ENCRYPTION_KEY=change-me-fernet-key
AGENTRY_WIDGET_SECRET=change-me

# ---- Email (sign-in links, invitations, alerts, statements). One set serves the dashboard and the API ----
# Port 587 uses STARTTLS automatically; for port 465 also set SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Agentry <hello@agentry.example>
AGENTRY_OPS_EMAIL=you@agentry.example
# how Agentry's own sales emails (demo requests) are signed
AGENTRY_SALES_SIGNATURE=The Agentry team
# replies to sales emails are read here (read-only) with SMTP_USER/SMTP_PASSWORD; default imap.gmail.com when SMTP is Gmail
AGENTRY_IMAP_HOST=
AGENTRY_TELEGRAM_BOT_TOKEN=
AGENTRY_OPS_TELEGRAM_CHAT_ID=

# ---- Models (Gemini first, OpenAI fallback; see docs/decisions/0003). Empty tier = mock mode ----
GEMINI_API_KEY=
OPENAI_API_KEY=
AGENTRY_MODEL_FAST=
AGENTRY_MODEL_WRITER=
AGENTRY_MODEL_CONVERSATION=
AGENTRY_MODEL_VISION=
AGENTRY_MODEL_EMBED=

# ---- Voice (docs/PHASE-4-VOICE.md). LiveKit Cloud: wss://<project>.livekit.cloud; the browser connects to the PUBLIC url ----
AGENTRY_LIVEKIT_URL=
AGENTRY_LIVEKIT_PUBLIC_URL=
AGENTRY_LIVEKIT_API_KEY=
AGENTRY_LIVEKIT_API_SECRET=
AGENTRY_MODEL_VOICE=openai/gpt-4.1-mini
AGENTRY_VOICE_RECORD=true

# ---- Channels (docs/setup/gmail.md, docs/setup/whatsapp.md) ----
AGENTRY_GOOGLE_CLIENT_ID=
AGENTRY_GOOGLE_CLIENT_SECRET=
# Gmail push (optional, docs/setup/gmail.md §6)
AGENTRY_GMAIL_PUBSUB_TOPIC=
AGENTRY_GMAIL_PUSH_TOKEN=
# Outlook / Microsoft 365 (optional, docs/setup/outlook.md)
AGENTRY_MICROSOFT_CLIENT_ID=
AGENTRY_MICROSOFT_CLIENT_SECRET=
AGENTRY_MICROSOFT_TENANT=common
AGENTRY_WHATSAPP_APP_SECRET=
AGENTRY_WHATSAPP_VERIFY_TOKEN=

# ---- Agentry's own billing (payment links on statements) ----
AGENTRY_COMPANY_GSTIN=
AGENTRY_BILLING_RAZORPAY_KEY_ID=
AGENTRY_BILLING_RAZORPAY_KEY_SECRET=
AGENTRY_BILLING_RAZORPAY_WEBHOOK_SECRET=
AGENTRY_BILLING_STRIPE_SECRET_KEY=
AGENTRY_BILLING_STRIPE_WEBHOOK_SECRET=
